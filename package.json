{
  "name": "micro-visor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces build",
    "typecheck": "npm run --workspaces typecheck",
    "dev:signaling": "npm run -w @micro-visor/signaling dev",
    "dev:agent": "npm run -w @micro-visor/agent-cli dev",
    "dev:viewer": "npm run -w @micro-visor/viewer-cli dev"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}