{
  "name": "micro-visor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint \"{apps,packages,services}/**/src/**/*.ts\"",
    "test": "npm run -w @micro-visor/signaling test && npm run -w @micro-visor/agent-runtime test",
    "test:watch": "npm run -w @micro-visor/signaling test:watch",
    "build": "npm run --workspaces build",
    "typecheck": "npm run --workspaces typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run format:check",
    "dev:signaling": "npm run -w @micro-visor/signaling dev",
    "dev:agent": "npm run dev:agent-runtime",
    "dev:agent-runtime": "npm run -w @micro-visor/agent-runtime dev",
    "dev:viewer": "npm run -w @micro-visor/viewer-cli dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript-eslint": "^8.27.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
